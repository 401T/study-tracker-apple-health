    "contrast": "node --experimental-strip-types scripts/check-contrast.ts",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  },
  "private": true
}
