{
  "name": "study-tracker-apple-health",
  "version": "1.0.0",
  "description": "Apple Health × Liquid Glass study time tracker — portable single-file web app with AI-readable data layer",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
