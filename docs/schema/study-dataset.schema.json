{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "study-tracker-apple-health/study-dataset.schema.json",
  "title": "StudyDataset (schemaVersion 1)",
  "description": "Canonical dataset of study-tracker-apple-health. All *Sec fields are integer seconds. Dates are local YYYY-MM-DD. Date-times are ISO 8601 with offset. Unknown fields must be preserved (extra / extensions).",
  "type": "object",
  "required": ["schema", "schemaVersion", "meta", "settings", "subjects", "tasks", "records", "plans", "activeSession"],
  "properties": {
    "schema": { "const": "study-tracker-apple-health" },
    "schemaVersion": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["createdAt", "updatedAt", "timezone"],
      "properties": {
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" },
        "timezone": { "type": "string", "description": "IANA zone of the device that last wrote the dataset" },
        "legacy": {
          "type": "object",
          "properties": { "format": { "type": "string" }, "importedAt": { "$ref": "#/$defs/dateTime" }, "fingerprint": { "type": "string" } }
        }
      }
    },
    "settings": {
      "type": "object",
      "required": ["theme", "glass", "dailyGoalSec", "weekStartsOn"],
      "properties": {
        "theme": { "enum": ["system", "light", "dark"] },
        "glass": { "enum": ["standard", "reduced"] },
        "dailyGoalSec": { "$ref": "#/$defs/seconds", "description": "PLANNED daily study time" },
        "weekStartsOn": { "enum": [0, 1] },
        "extra": { "type": "object" }
      }
    },
    "subjects": { "type": "array", "items": { "$ref": "#/$defs/subject" } },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
    "plans": { "type": "array", "items": { "$ref": "#/$defs/plan" } },
    "activeSession": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["startedAt", "subjectId", "taskId", "note", "breaks"],
          "properties": {
            "startedAt": { "$ref": "#/$defs/dateTime" },
            "subjectId": { "type": ["string", "null"] },
            "taskId": { "type": ["string", "null"] },
            "note": { "type": "string" },
            "breaks": {
              "type": "array",
              "items": { "type": "object", "required": ["start", "end"], "properties": { "start": { "$ref": "#/$defs/dateTime" }, "end": { "oneOf": [{ "$ref": "#/$defs/dateTime" }, { "type": "null" }] } } }
            }
          }
        }
      ]
    },
    "extensions": { "type": "object", "description": "Unknown top-level fields preserved verbatim" }
  },
  "$defs": {
    "seconds": { "type": "integer", "minimum": 0 },
    "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "dateTime": { "type": "string", "description": "ISO 8601 with UTC offset" },
    "record": {
      "type": "object",
      "description": "ACTUAL study block. durationSec = study time excluding breaks (used by every total). elapsedSec = wall clock incl. breaks.",
      "required": ["id", "date", "timezone", "startAt", "endAt", "durationSec", "elapsedSec", "breakSec", "subjectId", "taskId", "note", "source", "createdAt", "updatedAt", "deletedAt"],
      "properties": {
        "id": { "type": "string" },
        "date": { "$ref": "#/$defs/localDate" },
        "timezone": { "type": "string" },
        "startAt": { "oneOf": [{ "$ref": "#/$defs/dateTime" }, { "type": "null" }] },
        "endAt": { "oneOf": [{ "$ref": "#/$defs/dateTime" }, { "type": "null" }] },
        "durationSec": { "$ref": "#/$defs/seconds" },
        "elapsedSec": { "oneOf": [{ "$ref": "#/$defs/seconds" }, { "type": "null" }] },
        "breakSec": { "$ref": "#/$defs/seconds" },
        "subjectId": { "type": ["string", "null"] },
        "taskId": { "type": ["string", "null"] },
        "note": { "type": "string", "description": "What was studied (user-authored free text)" },
        "source": { "enum": ["timer", "manual", "import", "legacy", "agent"] },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" },
        "deletedAt": { "oneOf": [{ "$ref": "#/$defs/dateTime" }, { "type": "null" }] },
        "extra": { "type": "object" }
      }
    },
    "subject": {
      "type": "object",
      "required": ["id", "name", "color", "weeklyGoalSec", "archived", "order", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "enum": ["blue", "green", "orange", "pink", "purple", "teal", "yellow", "red", "indigo", "brown"] },
        "weeklyGoalSec": { "oneOf": [{ "$ref": "#/$defs/seconds" }, { "type": "null" }], "description": "PLANNED weekly time" },
        "archived": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" },
        "extra": { "type": "object" }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "subjectId", "title", "status", "dueDate", "note", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string" },
        "subjectId": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "status": { "enum": ["open", "done"] },
        "dueDate": { "oneOf": [{ "$ref": "#/$defs/localDate" }, { "type": "null" }] },
        "note": { "type": "string" },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" },
        "extra": { "type": "object" }
      }
    },
    "plan": {
      "type": "object",
      "description": "PLANNED study time for an inclusive date range. subjectId null = all subjects.",
      "required": ["id", "periodStart", "periodEnd", "subjectId", "plannedSec", "note", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string" },
        "periodStart": { "$ref": "#/$defs/localDate" },
        "periodEnd": { "$ref": "#/$defs/localDate" },
        "subjectId": { "type": ["string", "null"] },
        "plannedSec": { "$ref": "#/$defs/seconds" },
        "note": { "type": "string" },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" },
        "extra": { "type": "object" }
      }
    }
  }
}
